generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// F1: Identity, Workspace, Permissions
// ============================================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  permissionSets   PermissionSet[]
  leads            Lead[]
  auditLogs        AuditLog[]
  assignmentRules  AssignmentRule[]
  employeeStatuses EmployeeStatus[]
  companies        Company[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  integrations     IntegrationConnection[]
  integrationEvents IntegrationEvent[]
  pipelines        Pipeline[]
  opportunities    Opportunity[]
  customFields     CustomFieldDefinition[]
  payments         Payment[]
  appointments     Appointment[]
}

enum BaseRole {
  OWNER
  ADMIN
  USER
}

model User {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String
  baseRole     BaseRole @default(USER)

  permissionSetId String?
  permissionSet   PermissionSet? @relation(fields: [permissionSetId], references: [id])

  permissionOverrides PermissionOverride[]
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())

  sessions          Session[]
  employeeStatus    EmployeeStatus?
  leadAssignments   LeadAssignment[]
  opportunities     Opportunity[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A PermissionSet IS what "Manager" becomes: seeded as a convenience preset
// at workspace creation, but it is an ordinary, fully editable/clonable/
// deletable row like any other set the Owner or Admin creates later.
model PermissionSet {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean   @default(false) // true only for the Owner's implicit full-access set

  permissions PermissionSetItem[]
  users       User[]
  createdAt   DateTime            @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// One row per (resource, action) granted. resource/action are a closed
// string union defined in @ubp/shared, not free text.
model PermissionSetItem {
  id              String        @id @default(cuid())
  permissionSetId String
  permissionSet   PermissionSet @relation(fields: [permissionSetId], references: [id], onDelete: Cascade)
  resource        String
  action          String
  fieldMask       String[]      @default([])

  @@unique([permissionSetId, resource, action])
}

// Per-user exceptions layered on top of a user's PermissionSet.
model PermissionOverride {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource String
  action   String
  effect   String // "grant" | "revoke"

  @@unique([userId, resource, action])
}

// ============================================================================
// F3: Lead lifecycle engine
// ============================================================================

enum EmployeeAvailability {
  AVAILABLE
  BUSY
  ON_LEAVE
  OFFLINE
}

model EmployeeStatus {
  id           String               @id @default(cuid())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability EmployeeAvailability @default(OFFLINE)
  maxOpenLeads Int                  @default(10)
  updatedAt    DateTime             @updatedAt

  @@index([workspaceId, availability])
}

model AssignmentRule {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ackWindowSeconds     Int
  // Ordered chain: [{type:"next_eligible"}, {type:"backup", userId}, {type:"manager", userId}],
  // each entry carrying its own timeoutSeconds. If the chain is exhausted and
  // the lead is still unacknowledged, the engine auto-escalates once more to
  // the Workspace Owner as an implicit final level (confirmed product rule).
  escalationLevels     Json
  idleThresholdSeconds Int
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())

  @@index([workspaceId, isActive])
}

enum LeadSource {
  WEB_FORM
  WHATSAPP
  MANUAL
}

enum LeadStatus {
  NEW
  ASSIGNED
  ACKNOWLEDGED
  ESCALATED
  CONVERTED
  LOST
}

model Lead {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  source     LeadSource
  name       String
  phone      String?
  email      String?
  notes      String?
  rawPayload Json?
  status     LeadStatus @default(NEW)

  currentOwnerId  String? // denormalized "who owns it right now" -- single source of truth
  createdAt       DateTime  @default(now())
  firstAssignedAt DateTime? // glossary: "Assigned time" (first assignment)
  firstAckAt      DateTime? // glossary: "Time to first response" = firstAckAt - firstAssignedAt
  escalationCount Int       @default(0)
  lockVersion     Int       @default(0)

  // Set when the lead is converted into a deal (F2 / journey step 4).
  convertedOpportunityId String?
  convertedOpportunity   Opportunity? @relation(fields: [convertedOpportunityId], references: [id], onDelete: SetNull)

  assignments    LeadAssignment[]
  escalationJobs EscalationJob[]

  @@index([workspaceId, status])
  @@index([workspaceId, currentOwnerId])
  @@index([workspaceId, createdAt])
}

enum AssignmentEndReason {
  ACKNOWLEDGED
  ESCALATED_TIMEOUT
  MANUAL_REASSIGN
  STATUS_CHANGE_REASSIGN
}

// One row per "hold" of a lead by one assignee -- this IS the escalation history.
model LeadAssignment {
  id              String               @id @default(cuid())
  leadId          String
  lead            Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId      String
  assignee        User                 @relation(fields: [assigneeId], references: [id])
  assignedAt      DateTime             @default(now())
  ackAt           DateTime?
  endedAt         DateTime?
  endReason       AssignmentEndReason?
  escalationLevel Int                  @default(0)

  escalationJobs EscalationJob[]

  @@index([leadId])
  @@index([assigneeId, ackAt])
}

// Durable, DB-backed record of a pending timer. The BullMQ job is a cache of
// this row, never the source of truth -- on boot, reconciliation reconstructs
// pending timers from this table, not from the queue.
enum EscalationJobStatus {
  PENDING
  FIRED
  CANCELLED
}

model EscalationJob {
  id           String              @id @default(cuid())
  leadId       String
  lead         Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   LeadAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fireAt       DateTime
  status       EscalationJobStatus @default(PENDING)
  bullJobId    String?
  createdAt    DateTime            @default(now())

  @@index([status, fireAt])
  @@index([leadId])
}

// ============================================================================
// F4: Audit log -- append-only. No update/delete endpoint exists at all.
// ============================================================================

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String? // null for system/automated actions (e.g. auto-escalation)
  actorLabel  String // denormalized display name, survives actor deletion
  eventType   String // "lead.assigned" | "lead.escalated" | "permission.changed" | ...
  targetType  String // "Lead" | "User" | "PermissionSet" | ...
  targetId    String
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, eventType, createdAt])
  @@index([workspaceId, targetType, targetId])
}

// ============================================================================
// F2: Customizable CRM -- companies, contacts, pipelines, stages, deals
// ============================================================================

model Company {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  domain    String?
  logoUrl   String?
  createdAt DateTime @default(now())

  contacts Contact[]

  @@index([workspaceId])
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  email     String?
  phone     String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  tags     String[] @default([])
  optedOut Boolean  @default(false)
  // Custom field values keyed by CustomFieldDefinition.key. JSONB rather than
  // an EAV table: one row per record keeps reads simple and the definitions
  // table still drives validation and rendering.
  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
  appointments  Appointment[]
  conversations Conversation[]

  @@index([workspaceId])
  @@index([workspaceId, phone])
  @@index([workspaceId, email])
}

model Pipeline {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  stages        Stage[]
  opportunities Opportunity[]
  customFields  CustomFieldDefinition[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

enum StageType {
  OPEN
  WON
  LOST
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name     String
  position Int
  type     StageType @default(OPEN)
  color    String    @default("slate")
  // Keys of CustomFieldDefinition rows a deal must have filled before it can
  // enter this stage (F2.4).
  requiredFieldKeys String[] @default([])

  opportunities Opportunity[]

  @@index([pipelineId, position])
}

model Opportunity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  value    Decimal  @default(0) @db.Decimal(14, 2)
  currency String   @default("PKR")
  tag      String?

  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  ownerId    String?
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  customFields Json     @default("{}")
  // Optimistic-concurrency guard: a stale update is rejected rather than
  // silently overwriting a concurrent edit (Q4).
  version      Int      @default(0)
  closedAt     DateTime?
  expectedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     Payment[]
  appointments Appointment[]
  leads        Lead[]

  @@index([workspaceId, stageId])
  @@index([workspaceId, pipelineId])
  @@index([workspaceId, ownerId])
  @@index([contactId])
}

enum CustomFieldRecordType {
  CONTACT
  COMPANY
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
}

model CustomFieldDefinition {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  recordType CustomFieldRecordType
  // null means the field applies to every pipeline; set means it is specific
  // to one pipeline, which is what makes F2.3 work.
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  key     String
  label   String
  type    CustomFieldType
  options String[] @default([])
  // Deleting a field archives it: hidden everywhere, data kept, restorable (A2.5).
  archivedAt DateTime?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([workspaceId, recordType, pipelineId, key])
  @@index([workspaceId, recordType])
}

// ============================================================================
// Payments and appointments -- records exist now so the CRM and dashboard can
// read them; the Stripe/Google integrations that populate them land later.
// ============================================================================

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("PKR")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("stripe")
  providerRef String?
  requestedBy String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([workspaceId, status])
  @@index([opportunityId])
}

model Appointment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  title       String
  startsAt    DateTime
  endsAt      DateTime
  timeZone    String  @default("Asia/Karachi")
  googleEventId String?
  ownerId     String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, startsAt])
}

// ============================================================================
// I1 / I5: messaging conversations and the integration framework
// ============================================================================

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel   Channel @default(WHATSAPP)

  // Shown on the conversation and used to gate visibility (I1.6).
  assignedUserId String?
  lastMessageAt  DateTime @default(now())
  // Last inbound message time: the WhatsApp free-form reply window is 24h
  // from this, which the composer surfaces.
  lastInboundAt  DateTime?
  createdAt      DateTime @default(now())

  messages Message[]

  @@unique([workspaceId, contactId, channel])
  @@index([workspaceId, lastMessageAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection
  body      String
  status    MessageStatus    @default(RECEIVED)
  // The provider's own message id. Unique per workspace so a webhook
  // delivered twice cannot create two messages (I1.8).
  providerRef   String?
  failureReason String?
  sentByUserId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, providerRef])
  @@index([conversationId, createdAt])
}

enum IntegrationProvider {
  WHATSAPP_CLOUD
  STRIPE
  GOOGLE_CALENDAR
  RESEND
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

model IntegrationConnection {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider IntegrationProvider
  status   IntegrationStatus   @default(NOT_CONNECTED)
  // Per-workspace credentials. Never returned to the browser in full --
  // only a last-4 hint is exposed (I5.2, I5.3).
  credentials Json @default("{}")
  // Routes an inbound webhook to exactly one workspace, so one tenant's
  // provider can never deliver into another's data.
  webhookKey    String  @unique @default(cuid())
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
}

/// Synchronization history: every inbound webhook and outbound call, so
/// nothing an external service does is silently lost (I5.4).
model IntegrationEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider  IntegrationProvider
  direction IntegrationDirection
  eventType String
  // Provider's event/message id, used to ignore duplicate deliveries.
  providerEventId String?
  payload         Json?
  success         Boolean  @default(true)
  error           String?
  reference       String?
  createdAt       DateTime @default(now())

  @@unique([workspaceId, provider, providerEventId])
  @@index([workspaceId, provider, createdAt])
}
