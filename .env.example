# --- Database / Cache ---
DATABASE_URL="postgresql://app:app@localhost:5433/ubp?schema=public"
REDIS_URL="redis://localhost:6380"

# --- API ---
API_PORT=4000
SESSION_COOKIE_NAME="ubp_session"
SESSION_TTL_HOURS=24
WEB_ORIGIN="http://localhost:5180"

# --- Escalation timing ---
# Dev-only override so escalation windows can be configured in single-digit
# seconds for a live demo. In a real deployment this would enforce a sane
# production floor (e.g. 300s); for the hackathon demo we allow it to be low.
ESCALATION_MIN_WINDOW_SECONDS=3

# --- Integrations (added in later phases, not required for MVP core) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- WhatsApp Cloud API (Meta) ---
# From developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# "Generate access token" on that page. The temporary one lasts 24h.
WHATSAPP_ACCESS_TOKEN=
# App Settings -> Basic -> App Secret. Signs the inbound webhooks.
WHATSAPP_APP_SECRET=
# Any random string (e.g. `openssl rand -hex 16`); must match Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Stable webhook key so a reseed doesn't invalidate the provider console URL.
WHATSAPP_WEBHOOK_KEY=pick-any-stable-string

# Public HTTPS base the provider calls back on (ngrok in dev).
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.dev
